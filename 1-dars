let quizScore=0,answered=0;
function renderQuiz(){let q=document.getElementById("quiz");q.innerHTML="";questions.forEach((x,qi)=>{let box=document.createElement("div");box.className="card";box.style.boxShadow="none";box.innerHTML=`<div class="quiz-q">${qi+1}. ${x[0]}</div>`;x[1].forEach((opt,oi)=>{let b=document.createElement("button");b.className="quiz-option";b.textContent=opt;b.onclick=()=>answerQuiz(qi,oi,box);box.appendChild(b)});let ex=document.createElement("div");ex.className="quiz-explain";ex.style.display="none";box.appendChild(ex);q.appendChild(box)})}
function answerQuiz(qi,oi,box){if(box.dataset.done)return;box.dataset.done="1";answered++;let bs=box.querySelectorAll(".quiz-option");bs[questions[qi][2]].classList.add("correct");let ex=box.querySelector(".quiz-explain");if(oi===questions[qi][2]){quizScore++;ex.textContent="✅ To‘g‘ri javob!";}else{bs[oi].classList.add("wrong");ex.textContent="❌ Noto‘g‘ri. To‘g‘ri javob: "+questions[qi][1][questions[qi][2]]+". "}ex.style.display="block";if(answered===questions.length){let r=document.getElementById("quizResult");r.style.display="block";r.className="feedback good";r.innerHTML=`<b>Natija: ${quizScore}/${questions.length}</b> — ${quizScore>=4?"Mavzuni yaxshi o‘zlashtirdingiz!":"Yaxshi harakat. Mavzuni yana bir marta ko‘rib chiqing."}`;document.getElementById("summary").style.display="block"}}
